# База API (см. Swagger https://serg.srvmysticode.ru/docs/#/ )
VITE_API_BASE=https://serg.srvmysticode.ru

# ID мини-приложения VK (как в vk-hosting-config.json → app_id). Ссылка для пользователей: https://vk.com/app{id}
# VITE_VK_APP_ID=54570453

# Включить/выключить запросы к бэкенду явно. Если не задано: внутри VK или Telegram Mini App сеть включается сама; вне них — выключена.
# VITE_ENABLE_BACKEND=true
# VITE_ENABLE_BACKEND=false

# Опционально: JWT для локальных запросов (Bearer) к /tarot/*, /horoscope/*, /layoutAllowed, /generate, …
# без Telegram initData
# VITE_DEV_BEARER_TOKEN=eyJhbGciOi...

# Product ID тарифов подписки (списание астрокоинов через POST /subscribe/buy, поле `id` = этот product_id).
# Обязательны для оплаты подписки (VK и YooKassa): без них кнопки оплаты покажут ошибку.
# Значения — целые числа из вашей админки/каталога товаров на бэкенде Mystic.
# ВАЖНО: Vite подставляет их при СБОРКЕ. Для VK мини-приложения задайте переменные в .env на машине сборки
# или в секретах CI, затем npm run build:vk — иначе в опубликованном dist их не будет.
# VITE_SUBSCRIPTION_PRODUCT_ID_WEEK=101
# VITE_SUBSCRIPTION_PRODUCT_ID_MONTH=102
# VITE_SUBSCRIPTION_PRODUCT_ID_YEAR=103

# Пополнение астрокоинов (GET /crystalMoney → id пакета; оплата POST /payments/yookassa/card/invoice).
# Если в каталоге нет ровно 100 / 500 / … кристаллов, задайте id вручную:
# VITE_CRYSTAL_PACK_ID_100=…
# VITE_CRYSTAL_PACK_ID_500=…
# VITE_CRYSTAL_PACK_ID_1000=…
# VITE_CRYSTAL_PACK_ID_3000=…
# VITE_CRYSTAL_PACK_ID_5000=…

# Консультации: список и цены с GET /service/catalog; оплата POST /service/orders/yookassa/invoice (service_id = id из каталога).
# Если на сервере другой путь к каталогу:
# VITE_SERVICE_CATALOG_PATH=/service/catalog
# Сопоставление «Астролог / Таролог / Универсальный» с позицией каталога — по названию/описанию; если не сходится, задайте явный id:
# VITE_CONSULT_SERVICE_ID_ASTROLOGER=201
# VITE_CONSULT_SERVICE_ID_TAROLOGIST=202
# VITE_CONSULT_SERVICE_ID_UNIVERSAL=203
# VITE_CONSULT_SERVICE_ID_VESPER=204
# (устаревшие имена, то же значение — id услуги в каталоге:)
# VITE_CONSULT_PRODUCT_ID_ASTROLOGER=201
# VITE_CONSULT_PRODUCT_ID_TAROLOGIST=202
# VITE_CONSULT_PRODUCT_ID_UNIVERSAL=203
